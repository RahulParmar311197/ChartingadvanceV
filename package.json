{
  "name": "chartingadvancev",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "api": "tsx apps/api/src/index.js",
    "realtime": "tsx apps/api/src/realtime.js",
